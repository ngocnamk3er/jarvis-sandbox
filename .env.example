APP_NAME=Jarvis Sandbox
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# Must match jarvis-backend's INTERNAL_API_KEY — shared secret proving a
# request came from jarvis-backend. This service is never reachable from the
# frontend/ingress, same posture as jarvis-conversation-service.
INTERNAL_API_KEY=changeme-dev-only

# Root of the per-conversation working directories (/workspace/{thread_id}).
WORKSPACE_ROOT=/workspace
# Default per-command wall-clock limit (seconds); jarvis-backend passes its
# own 300 anyway.
COMMAND_TIMEOUT_SECONDS=300
# A thread dir untouched for longer than this is rm -rf'd by the GC loop.
IDLE_GC_MINUTES=60
