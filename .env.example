APP_NAME=Jarvis Sandbox
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# Must match jarvis-backend's INTERNAL_API_KEY — shared secret proving a
# request came from jarvis-backend. This service is never reachable from the
# frontend/ingress, same posture as jarvis-conversation-service.
INTERNAL_API_KEY=changeme-dev-only

# Root of the per-conversation trees: DATA_ROOT/<thread_id>/workspace/.
# In k8s this is the emptyDir mount. Locally, any writable dir.
DATA_ROOT=/tmp/jarvis-sandbox

# Default per-command wall-clock limit (seconds); jarvis-backend passes 300.
COMMAND_TIMEOUT_SECONDS=300
# A thread dir untouched for longer than this is rm -rf'd by the GC loop.
IDLE_GC_MINUTES=60

# Per-conversation uid range used by `setpriv` (defence-in-depth alongside the
# mount namespace). Only relevant when the jail actually runs — see README.
UID_BASE=20000
UID_RANGE=40000
