APP_NAME=Jarvis Sandbox
APP_VERSION=0.2.0
API_PREFIX=/api/v1

# "agent" (default) runs bash in a local dir — no cluster, no isolation, fine
# for one developer (same posture as the old UNSAFE_NO_JAIL). "orchestrator"
# needs a kubeconfig / in-cluster creds and manages a pool of agent pods.
SANDBOX_ROLE=agent

# Must match jarvis-backend's INTERNAL_API_KEY — shared secret proving a
# request came from jarvis-backend. Only the orchestrator checks it.
INTERNAL_API_KEY=changeme-dev-only

# ---- agent role ----
# The one dir the command sees. In k8s an emptyDir; locally any writable dir.
WORKSPACE_DIR=/tmp/jarvis-sandbox/workspace
COMMAND_TIMEOUT_SECONDS=300
# Per-pod token the orchestrator injects. Empty locally -> no check.
AGENT_TOKEN=

# ---- orchestrator role (ignored when SANDBOX_ROLE=agent) ----
POD_NAMESPACE=jarvis
# Empty -> orchestrator reads its own running image off the k8s API.
SANDBOX_IMAGE=
POOL_SIZE=1
MAX_SANDBOXES=6
IDLE_GC_MINUTES=60
CLAIM_TIMEOUT_SECONDS=40
# Set to "gvisor" once the RuntimeClass exists on the cluster.
SANDBOX_RUNTIME_CLASS=
